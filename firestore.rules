rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Permitir lectura y escritura de puntos de interés y categorías de Pastoral Social
    // para sincronización colaborativa entre el equipo
    match /points/{pointId} {
      allow read, write: if true;
    }
    match /categories/{categoryId} {
      // Las 5 líneas institucionales actuales están protegidas: lectura y creación inicial permitidas, pero no edición ni eliminación
      allow read, create: if true;
      allow update, delete: if !(categoryId in [
        'linea_pastoral_rural_tierra',
        'linea_seguridad_soberania_alimentaria',
        'linea_cuidado_justicia',
        'linea_mujer',
        'linea_comites_parroquiales'
      ]);
    }
    match /population_types/{typeId} {
      allow read, write: if true;
    }
    match /settings/{settingId} {
      allow read, write: if true;
    }
  }
}
